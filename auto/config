#!/bin/sh
set -e

# ArgOS live-build configuration.
#
# This bootstraps from Kali's own kali-rolling repository (not plain Debian),
# using the same live-build tool Kali itself is built with -- we are not
# reimplementing Kali's packaging, just pointing stock live-build at Kali's
# mirrors and keyring. The host (or the Dockerfile) must have the
# kali-archive-keyring package installed so debootstrap can verify kali-rolling
# release signatures and find the matching debootstrap script.
#
# Every flag below was verified against Kali's actual live-build package
# (1:20250814+kali3 -- downloaded straight from kali.download and run here,
# not just read about) by actually running `lb config` in this repo. An
# earlier version of this file was verified against the Debian/Ubuntu
# packaging of live-build instead, which turned out to use different flag
# names for several of these (singular --bootloader vs plural
# --bootloaders, --bootstrap-keyring vs --debootstrap-options, singular
# --architecture/--binary-image vs plural) -- live-build's flag set is not
# stable across packagings/releases. If this errors on a different
# live-build version, re-check with `lb config -u`.
#
# --security/--updates exist in this version but are left unset: they add
# a Debian-style stable+security/updates suite split, which doesn't apply
# to kali-rolling's single rolling suite.

lb config noauto \
    --distribution "kali-rolling" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --architecture "amd64" \
    --binary-image "iso-hybrid" \
    --bootappend-live "boot=live components username=argos hostname=argos-live quiet splash" \
    --bootloaders "grub-pc" \
    --mirror-bootstrap "https://http.kali.org/kali" \
    --mirror-chroot "https://http.kali.org/kali" \
    --mirror-binary "https://http.kali.org/kali" \
    --mirror-chroot-security "https://http.kali.org/kali" \
    --mirror-binary-security "https://http.kali.org/kali" \
    --debootstrap-options "--keyring=/usr/share/keyrings/kali-archive-keyring.gpg" \
    --keyring-packages "kali-archive-keyring" \
    --apt-recommends false \
    --firmware-chroot true \
    --firmware-binary true \
    --linux-packages "linux-image" \
    --debian-installer none \
    --iso-volume "ArgOS" \
    --iso-application "ArgOS" \
    --iso-publisher "ArgOS" \
    --iso-preparer "ArgOS live-build" \
    --chroot-squashfs-compression-type "zstd" \
    "${@}"
