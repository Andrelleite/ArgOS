#!/bin/sh
set -e

# ArgOS live-build configuration.
#
# This bootstraps from Kali's own kali-rolling repository (not plain Debian),
# using the same live-build tool Kali itself is built with -- we are not
# reimplementing Kali's packaging, just pointing stock live-build at Kali's
# mirrors and keyring. The host (or the Dockerfile) must have the
# kali-archive-keyring package installed so debootstrap can verify kali-rolling
# release signatures and find the matching debootstrap script.
#
# Every flag below was verified against a real, installed live-build
# (3.0~a57) by actually running `lb config` in this repo, not just
# written from memory -- live-build's flag set has drifted across
# releases and several guessed names turned out wrong (--bootloaders
# isn't real, it's singular --bootloader; --debootstrap-options isn't
# real either, --bootstrap-keyring is the actual flag for this). Still,
# re-check with `lb config --help` if this errors on a different
# live-build version/release than what was tested here.
#
# --security/--updates are deliberately omitted: they add a Debian-style
# stable+security/updates suite split, which doesn't apply to
# kali-rolling's single rolling suite.

lb config noauto \
    --distribution "kali-rolling" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --architectures "amd64" \
    --binary-images "iso-hybrid" \
    --bootappend-live "boot=live components username=argos hostname=argos-live quiet splash" \
    --bootloader "grub-pc" \
    --mirror-bootstrap "https://http.kali.org/kali" \
    --mirror-binary "https://http.kali.org/kali" \
    --mirror-chroot-security "https://http.kali.org/kali" \
    --mirror-binary-security "https://http.kali.org/kali" \
    --bootstrap-keyring "/usr/share/keyrings/kali-archive-keyring.gpg" \
    --apt-recommends false \
    --firmware-chroot true \
    --firmware-binary true \
    --linux-packages "linux-image" \
    --debian-installer none \
    --iso-volume "ArgOS" \
    --iso-application "ArgOS" \
    --iso-publisher "ArgOS" \
    --iso-preparer "ArgOS live-build" \
    "${@}"
