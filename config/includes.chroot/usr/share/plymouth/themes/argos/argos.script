# ArgOS boot splash: flat background, a centered static logo, and a
# boot-progress bar underneath it.
#
# The logo itself is still genuinely static -- it's placed once and
# never touched again, same as before. Only the progress bar below it
# updates, driven by Plymouth's real boot-progress callback (the same
# mechanism every script-based theme uses, including Kali's own shipped
# example at /usr/share/plymouth/themes/script/script.script, which this
# bar's structure is adapted from), not a generic timed animation.

# 0x0d0d11 as 0-1 floats (13/255, 13/255, 17/255), matching the flat
# background the logo image itself was composited onto.
Window.SetBackgroundTopColor(0.051, 0.051, 0.067);
Window.SetBackgroundBottomColor(0.051, 0.051, 0.067);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

# Progress bar track + fill, positioned well below the logo's lowest
# extent (logo is ~670px tall, centered in a 1080px canvas, so it ends
# around 81% down -- the bar sits at 90% to stay clear of it).
progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetX() + Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = Window.GetY() + Window.GetHeight() * 0.90 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.x = progress_box.x + (progress_box.image.GetWidth() - progress_bar.original_image.GetWidth()) / 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;

fun progress_callback (duration, progress)
  {
    new_width = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (new_width < 1)
      new_width = 1;
    progress_bar.image = progress_bar.original_image.Scale(new_width, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
    progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
  }

Plymouth.SetBootProgressFunction(progress_callback);
