<?xml version="1.0"?>
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<Menu>
  <Name>Applications</Name>
  <Layout>
    <Menuname>ArgOS-Recon</Menuname>
    <Menuname>ArgOS-Web</Menuname>
    <Menuname>ArgOS-Wireless</Menuname>
    <Menuname>ArgOS-Password</Menuname>
    <Menuname>ArgOS-Exploit</Menuname>
    <Menuname>ArgOS-PostExploit</Menuname>
    <Menuname>ArgOS-Forensics</Menuname>
    <Menuname>ArgOS-System</Menuname>
    <Merge type="all"/>
  </Layout>

  <Menu>
    <Name>ArgOS-Recon</Name>
    <Directory>argos-recon.directory</Directory>
    <Include>
      <Or>
        <Category>kali-account-discovery</Category>
