        <Category>kali-network-service-discovery</Category>
        <Category>kali-network-share-discovery</Category>
        <Category>kali-network-sniffing</Category>
        <Category>kali-process-discovery</Category>
        <Category>kali-reconnaissance</Category>
        <Category>kali-remote-system-discovery</Category>
        <Category>kali-smtp</Category>
        <Category>kali-snmp</Category>
        <Category>kali-ssl-tls</Category>
        <Category>kali-system-network-configuration-discovery</Category>
        <Category>kali-vulnerability-scanning</Category>
