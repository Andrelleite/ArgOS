#!/bin/sh
set -e

# Create the default ArgOS live user: argos/argos, passwordless sudo.
#
# SECURITY NOTE: this is a known, published default (same spirit as Kali's
# own historical root/toor live user) meant purely to get a live/USB session
# booted. Anyone who installs this to disk or exposes it on a network MUST
# run `passwd argos` (and review /etc/sudoers.d/argos-nopasswd) before
# trusting the machine with anything sensitive.

useradd -m -s /bin/bash -G sudo,adm,dialout,cdrom,floppy,audio,video,plugdev,netdev argos

# A fixed hash (not `chpasswd`'s randomly-salted one) so every ArgOS build
# produces the exact same /etc/shadow entry for "argos" -- argosd (see
# 0150-build-argos-tools.hook.chroot) compares against this exact string to
# detect whether the default password has ever been changed. This is the
# SHA-512 crypt() of "argos" with a fixed salt; changing the salt here
# requires updating ARGOS_DEFAULT_HASH in
# /usr/src/argos-tools/argosd/argosd.c to match.
usermod -p '$6$argosdefaultsalt$Fg6xszR//6fzLe8WrCYqucX3ZQp8sBV/74BakbC8shDLIun5GahhppNbFshQXn/JoJmCfdEYgtNqY1NnFqI2v.' argos

install -d -m 0750 /etc/sudoers.d
cat > /etc/sudoers.d/argos-nopasswd <<'EOF'
# Passwordless sudo for the default ArgOS live user.
# Remove or tighten this file on any persistent/installed system.
argos ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 /etc/sudoers.d/argos-nopasswd

# MOTD reminder so the security note isn't just buried in a repo somewhere.
install -d -m 0755 /etc/update-motd.d
cat > /etc/update-motd.d/00-argos-security-note <<'EOF'
#!/bin/sh
echo ""
echo "ArgOS: default login is argos/argos with passwordless sudo."
echo "Run 'passwd argos' before using this system beyond a throwaway live session."
echo "(argosd is watching for this -- see 'systemctl status argosd' / 'argosd --status'.)"
echo ""
EOF
chmod 0755 /etc/update-motd.d/00-argos-security-note
