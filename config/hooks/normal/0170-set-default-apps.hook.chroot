#!/bin/sh
set -e

# Chromium as default browser, Terminator as default terminal.
#
# Two mechanisms, both set, since different things consult different
# ones: Debian's update-alternatives (x-www-browser/x-terminal-emulator
# -- what most CLI tools and some desktop integrations check) and
# Xfce's own helpers.rc (what Thunar's "Open Terminal Here", the
# Whisker Menu, and other Xfce-specific integrations check instead).
#
# --install (not just --set) is used so this works regardless of
# whether chromium/terminator's own postinst already registered an
# alternative at this exact path -- idempotent either way.

update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/chromium 200
update-alternatives --set x-www-browser /usr/bin/chromium

update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/bin/terminator 200
update-alternatives --set x-terminal-emulator /usr/bin/terminator

install -d -m 0755 /etc/xdg/xfce4
cat > /etc/xdg/xfce4/helpers.rc <<'EOF'
TerminalEmulator=terminator
WebBrowser=chromium
EOF
