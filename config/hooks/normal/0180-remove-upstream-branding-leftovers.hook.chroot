#!/bin/sh
set -e

# Two branding leaks confirmed by extracting the real .deb packages
# directly, not assumed:
#
# 1. calamares-settings-debian ships its own autostart entry
#    (/etc/xdg/autostart/calamares-desktop-icon.desktop) that re-copies
#    an "Install Debian" shortcut onto the Desktop at *every login*,
#    independent of our own "Install ArgOS" shortcut
#    (/etc/skel/Desktop/install-argos.desktop). Its underlying
#    /usr/share/applications/calamares-install-debian.desktop entry
#    also surfaces in the application menu's System category on its
#    own. Removing both the autostart trigger and the launcher itself
#    is the only way to actually stop it coming back -- calamares-
#    settings-debian's actual installer config/modules (which our own
#    Install ArgOS shortcut depends on) are untouched.
if [ -f /etc/xdg/autostart/calamares-desktop-icon.desktop ]; then
    rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
fi
if [ -f /usr/share/applications/calamares-install-debian.desktop ]; then
    rm -f /usr/share/applications/calamares-install-debian.desktop
fi

# 2. kali-themes' postinst *diverts* a long list of config files
#    (confirmed by reading its actual postinst script) -- including
#    /etc/xdg/xfce4/whiskermenu/defaults.rc, which is where the panel's
#    start-menu button icon is set to "kali-panel-menu" and the
#    default favorites list points at kali-www/kali-tools/kali-docs/
#    kali-bugs/offsec-training/exploit-database/vulnhub. That diversion
#    happens during package install, before includes.chroot is ever
#    copied in, which is why ArgOS's own
#    config/includes.chroot/etc/xdg/xfce4/whiskermenu/defaults.rc
#    (shipped alongside this hook) is what actually overwrites it --
#    nothing left to do here for that one, noted for context since it's
#    the same class of issue as the Install Debian shortcut above.
#    The matching icon (argos-panel-menu) ships under
#    /usr/share/icons/hicolor/*/apps/ -- refresh the cache so it's
#    picked up without relying on icon-theme fallback directory
#    scanning.
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
fi

# 3. kali-menu ships its own application menu
#    (/etc/xdg/menus/applications-merged/kali-applications.menu), a
#    64-category tree following MITRE ATT&CK phase names, often nested
#    two levels deep (Reconnaissance > Host Information > ...). Per
#    direct request to make tool navigation actually easy, ArgOS ships
#    its own flat, 8-category menu
#    (config/includes.chroot/etc/xdg/menus/applications-merged/argos-applications.menu)
#    re-bucketing the exact same underlying Category tags every tool's
#    own .desktop file already carries -- no .desktop file anywhere
#    needed to change. Both files live in the same merge directory, so
#    leaving kali-applications.menu in place would just show every
#    tool in both structures at once; removing it is the only way to
#    get one clean tree instead of two overlapping ones.
if [ -f /etc/xdg/menus/applications-merged/kali-applications.menu ]; then
    rm -f /etc/xdg/menus/applications-merged/kali-applications.menu
fi
