#!/bin/sh
set -e

# ArgOS's own GTK3 + xfwm4 theme: window chrome, buttons, menus,
# scrollbars, not just the wallpaper/icons/login-screen branding
# elsewhere in this project. Per direct request for a macOS-like look
# (rounded corners, traffic-light window buttons) while staying light
# on resources, this is built from vinceliuice's WhiteSur-gtk-theme
# (github.com/vinceliuice/WhiteSur-gtk-theme) -- an actively-maintained
# project built specifically to clone macOS's look, confirmed (by
# reading libs/lib-install.sh directly, not the README, which barely
# mentions Xfce at all and focuses on GNOME) to genuinely build a real
# xfwm4 theme with its own themerc and PNG window-button assets, not
# just GTK widgets, and to specifically patch the Xfce Whisker Menu's
# appearance (`fix_whiskermenu`) -- real Xfce support, not just ported
# from a GNOME-only project.
#
# sassc (already added to desktop.list.chroot for the previous GTK
# theme attempt) is this project's only real build dependency too.
#
# -t red -c dark: ArgOS's own accent on a dark base, matching the rest
# of this project's palette, not the project's default macOS blue.
# -m (Monterey style) and --round (rounded corners survive maximizing,
# not just floating windows) are the two flags that actually produce
# the "round edges" look; --darker pushes the base closer to the
# near-black ArgOS already uses in Plymouth/GRUB/wallpapers. Only this
# one color/shade combination is built (the project ships many more by
# default), keeping build time and image size down.
#
# This project's folder-naming logic is more involved than the
# previous GTK theme's (name+color+opacity+alt+theme+scheme all
# concatenated, confirmed by reading libs/lib-install.sh's
# install_theemy()) -- rather than hardcode a guessed-at final folder
# name here and risk it silently drifting from whatever a future `git
# clone` of this actively-developed project actually produces, the
# built theme is found by what it actually contains (a real xfwm4
# subdirectory) and pointed at with a stable symlink. xsettings.xml and
# xfwm4.xml reference that stable "ArgOS" name, not the project's own
# internal naming scheme.

git clone --depth=1 https://github.com/vinceliuice/WhiteSur-gtk-theme /usr/src/argos-gtk-theme-build
cd /usr/src/argos-gtk-theme-build
bash install.sh -d /usr/share/themes -n ArgOS -t red -c dark -m --round --darker

cd /usr/share/themes
# Excludes the -hdpi/-xhdpi sibling folders the installer also builds
# alongside the base one (confirmed in lib-install.sh: HDPI_TARGET_DIR
# and XHDPI_TARGET_DIR are "${TARGET_DIR}-hdpi"/"-xhdpi") -- without
# this, a plain name match could pick either of those instead of the
# base theme non-deterministically.
BUILT_THEME=$(find . -mindepth 1 -maxdepth 1 -type d -name 'ArgOS*' \
    ! -name '*-hdpi' ! -name '*-xhdpi' \
    -exec test -d '{}/xfwm4' \; -print | sort | head -n1)
if [ -n "$BUILT_THEME" ]; then
    ln -sfn "$(basename "$BUILT_THEME")" ArgOS
fi

cd /
rm -rf /usr/src/argos-gtk-theme-build

# Applying the theme via xsettings.xml alone depends on xfsettingsd
# actually propagating it to running GTK3 apps via the XSETTINGS
# protocol at runtime. That mechanism is confirmed real (xfsettingsd's
# autostart entry is shipped directly by the xfce4-settings package,
# a hard Depends of xfce4, not something that can be silently
# missing) -- but it's still one more moving part than necessary for
# something this static. GTK3's own gtk-3.0/settings.ini is a plain
# file every GTK3 app reads directly at startup, no daemon or
# propagation involved, so it's written here too as a belt-and-
# suspenders mechanism that can't be affected by session-startup
# timing at all.
install -d -m 0755 /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=ArgOS
gtk-application-prefer-dark-theme=true
EOF

# /home/argos and /root already exist by this point in the build, so
# /etc/skel changes don't retroactively apply to them -- same reason
# 0165-setup-zsh-powerlevel10k.hook.chroot copies explicitly instead
# of relying on skel alone.
install -d -m 0755 /home/argos/.config/gtk-3.0
cp /etc/skel/.config/gtk-3.0/settings.ini /home/argos/.config/gtk-3.0/settings.ini
chown -R argos:argos /home/argos/.config/gtk-3.0

install -d -m 0755 /root/.config/gtk-3.0
cp /etc/skel/.config/gtk-3.0/settings.ini /root/.config/gtk-3.0/settings.ini
