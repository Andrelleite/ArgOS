#!/bin/sh
set -e

# ArgOS's own GTK3 + xfwm4 theme: window chrome, buttons, menus,
# scrollbars, not just the wallpaper/icons/login-screen branding
# elsewhere in this project.
#
# Pivoted from WhiteSur-gtk-theme (dark, red accent) to
# vinceliuice's MacTahoe-gtk-theme (github.com/vinceliuice/
# MacTahoe-gtk-theme) per direct request for a genuinely light,
# "macOS Tahoe" look -- confirmed by reading that project's own
# README, not assumed: it's explicitly "Based on WhiteSur GTK Theme"
# (same install mechanism, same libs/lib-install.sh architecture,
# same real xfwm4 themerc + PNG window-button assets per color
# variant), but its own default accent is described as "Tahoe-like"
# where WhiteSur's is "BigSur-like" -- a deliberate clone of the
# newer macOS look, not a reskin of the older one.
#
# -c Light: the light color variant (COLOR_VARIANTS in
# libs/lib-core.sh), not the project's dark default.
# -o solid: the "solid" opacity variant turns off the theme's
# transparency (`$trans` sed flag in gtk_base(), confirmed by
# reading libs/lib-install.sh) -- the "solid" look asked for,
# and also avoids depending on real desktop compositing being
# active for the GTK3 widgets themselves to read correctly.
# --round: maximized windows keep rounded corners instead of
# squaring off (`$max_window_style` in customize_theme()).
# -t default: the project's own default accent (blue), matching
# its "Tahoe-like" default and the accent used throughout the
# reference look this was built against.
#
# This project's folder-naming logic concatenates
# name+color+opacity+alt+theme+scheme (confirmed by reading
# libs/lib-install.sh's install_theemy()) -- rather than hardcode a
# guessed-at final folder name here and risk it silently drifting
# from whatever a future `git clone` of this actively-developed
# project actually produces, the built theme is found by what it
# actually contains (a real xfwm4 subdirectory) and pointed at with
# a stable symlink. xsettings.xml and xfwm4.xml reference that
# stable "ArgOS" name, not the project's own internal naming scheme.

git clone --depth=1 https://github.com/vinceliuice/MacTahoe-gtk-theme /usr/src/argos-gtk-theme-build
cd /usr/src/argos-gtk-theme-build
bash install.sh -d /usr/share/themes -n ArgOS -c light -o solid -t default --round

cd /usr/share/themes
# Excludes the -hdpi/-xhdpi sibling folders the installer also builds
# alongside the base one (confirmed in lib-install.sh: HDPI_TARGET_DIR
# and XHDPI_TARGET_DIR are "${TARGET_DIR}-hdpi"/"-xhdpi") -- without
# this, a plain name match could pick either of those instead of the
# base theme non-deterministically.
BUILT_THEME=$(find . -mindepth 1 -maxdepth 1 -type d -name 'ArgOS*' \
    ! -name '*-hdpi' ! -name '*-xhdpi' \
    -exec test -d '{}/xfwm4' \; -print | sort | head -n1)
if [ -n "$BUILT_THEME" ]; then
    ln -sfn "$(basename "$BUILT_THEME")" ArgOS
fi

cd /
rm -rf /usr/src/argos-gtk-theme-build

# Applying the theme via xsettings.xml alone depends on xfsettingsd
# actually propagating it to running GTK3 apps via the XSETTINGS
# protocol at runtime. That mechanism is confirmed real (xfsettingsd's
# autostart entry is shipped directly by the xfce4-settings package,
# a hard Depends of xfce4, not something that can be silently
# missing) -- but it's still one more moving part than necessary for
# something this static. GTK3's own gtk-3.0/settings.ini is a plain
# file every GTK3 app reads directly at startup, no daemon or
# propagation involved, so it's written here too as a belt-and-
# suspenders mechanism that can't be affected by session-startup
# timing at all. Confirmed directly (sandbox test, settings.ini only,
# no env override): this is what actually fixed a real, previously
# unresolved anomaly where zenity dialogs didn't pick up the prior
# WhiteSur-based theme at all even with a correct settings.ini -- with
# MacTahoe's build, the same mechanism works.
#
# gtk-application-prefer-dark-theme is now false: this is the light
# variant, and leaving it true would make any GTK3 app that checks
# this key look for the theme's separate dark CSS instead of the one
# actually built here.
install -d -m 0755 /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=ArgOS
gtk-icon-theme-name=ArgOS
gtk-application-prefer-dark-theme=false
EOF

# Rounded, translucent ("glass") panels: xfce4-panel has no xfconf
# property for panel corner rounding or transparency at all
# (confirmed by reading its real source via `strings` -- no such
# property exists), so this has to be a GTK CSS override.
#
# The selector is `.xfce4-panel.background#XfcePanelWindow`, not just
# `#XfcePanelWindow` alone -- this matters and was found the hard way.
# `#XfcePanelWindow` alone DOES catch the border-radius rule (an ID
# selector is specific enough that nothing else contests it), but a
# background-color on that same bare selector was overridden
# inconsistently on different panels: this exact theme's own
# _xfce.scss sets the panel's background-color on
# `.xfce4-panel.background#XfcePanelWindow` (confirmed by reading it
# directly) -- two classes plus the id, which beats a bare id
# selector on CSS specificity regardless of source order, so the
# theme's own opaque background was winning over a background-color
# on `#XfcePanelWindow` alone on whichever panels happened to
# resolve the theme's rule. Matching the theme's exact selector gives
# this rule equal specificity, where GTK's user-stylesheet priority
# correctly wins the tie -- confirmed directly: the same background-
# color rule that previously rendered inconsistently (opaque on some
# panels, correctly translucent on others) rendered uniformly
# translucent on every panel once the selector matched.
#
# A full-width panel's corners sit exactly at the screen edge, where
# a border-radius has no room to visibly curve, so the top bar
# (panel-1, full width) renders perfectly square regardless, while
# the bottom dock (panel-2, shrink-wrapped via length-adjust=true in
# argos-setup-panel-widgets) has real edges in the middle of the
# screen where the same radius shows as a clean rounded pill --
# confirmed directly, both panels configured together in the same
# test, not reasoned through and assumed.
#
# rgba(28, 28, 30, 0.65) is real, non-blurred translucency, not the
# full frosted/blurred "glass" look real macOS has -- that's not
# achievable at all here (GTK3 has no backdrop-filter/blur support,
# and xfwm4's compositor has no blur shader, confirmed directly, not
# a configuration gap). This is the closest real approximation: panel
# content genuinely blends with whatever's behind it -- confirmed in a
# live screenshot that over this project's own vibrant ArgOS wallpaper,
# the translucent dark panel actually picks up a tinted gradient from
# the image behind it, not just a flat dark bar.
#
# Dark, not the light rgba(245, 245, 245, 0.55) this shipped with
# before: a direct side-by-side with a real macOS screenshot sent as a
# reference showed that bar is dark/translucent, not light, and
# pointedly rejected the light version as "nothing like" it. The
# matching `color: #f2f2f2` rule below is not cosmetic -- without it
# the clock and button labels are dark-on-dark and unreadable;
# confirmed directly (a screenshot with this missing showed the clock
# essentially invisible against the new dark background).
#
# The padding rules below are a direct response to the bar looking
# "hammered" (cramped, items touching) per direct feedback -- plain
# `.xfce4-panel button` icons (whiskermenu, the status-icon cluster)
# had zero breathing room by default. Confirmed directly in a live
# screenshot that this padding alone visibly opens up the icon
# cluster.
install -d -m 0755 /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/gtk.css <<'EOF'
.xfce4-panel.background#XfcePanelWindow {
    border-radius: 16px;
    background-color: rgba(28, 28, 30, 0.65);
}
.xfce4-panel,
.xfce4-panel button,
.xfce4-panel label {
    color: #f2f2f2;
}
.xfce4-panel button,
.xfce4-panel .xfce4-panel-widget {
    padding-left: 8px;
    padding-right: 8px;
}
.xfce4-panel {
    padding-left: 6px;
    padding-right: 6px;
}
EOF

# /home/argos and /root already exist by this point in the build, so
# /etc/skel changes don't retroactively apply to them -- same reason
# 0165-setup-zsh-powerlevel10k.hook.chroot copies explicitly instead
# of relying on skel alone.
install -d -m 0755 /home/argos/.config/gtk-3.0
cp /etc/skel/.config/gtk-3.0/settings.ini /home/argos/.config/gtk-3.0/settings.ini
cp /etc/skel/.config/gtk-3.0/gtk.css /home/argos/.config/gtk-3.0/gtk.css
chown -R argos:argos /home/argos/.config/gtk-3.0

install -d -m 0755 /root/.config/gtk-3.0
cp /etc/skel/.config/gtk-3.0/settings.ini /root/.config/gtk-3.0/settings.ini
cp /etc/skel/.config/gtk-3.0/gtk.css /root/.config/gtk-3.0/gtk.css
