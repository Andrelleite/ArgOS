# ArgOS base system: shell, terminal, networking, boot. No desktop
# environment and no display manager -- this boots straight to a console
# login/shell, never Xfce/lightdm.

kali-archive-keyring

# Kali's own official CLI-only base metapackages -- pull in whatever base
# CLI tooling Kali itself considers core, so ArgOS stays in sync with
# upstream's own definition of "the base" rather than drifting from a
# hand-picked list.
kali-linux-core
kali-system-cli

# Kernel / boot / live infrastructure
linux-image-amd64
firmware-linux
firmware-iwlwifi
firmware-realtek
live-boot
live-config
live-config-systemd
grub-pc
grub-efi-amd64-bin
plymouth
os-prober
parted
gdisk
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
cryptsetup
lvm2

# Shell / terminal environment
bash
bash-completion
zsh
tmux
screen
vim
nano
less
man-db
locales
console-setup
keyboard-configuration
sudo
dialog
whiptail

# Core CLI utilities
coreutils
findutils
grep
sed
gawk
curl
wget
git
rsync
htop
tree
unzip
zip
7zip
jq
ripgrep
axel
rake
expect
dos2unix

# Networking stack (CLI only)
iproute2
net-tools
isc-dhcp-client
network-manager
wpasupplicant
wireless-tools
iw
usbutils
pciutils
openssh-client
openssh-server
bind9-dnsutils
traceroute
netcat-traditional
socat
proxychains4
tcpdump
ethtool
ifenslave
vlan
openvpn
vpnc
miredo
cifs-utils
telnet
unrar
plocate

# System services
systemd-timesyncd
apt-transport-https
ca-certificates
gnupg
pipx
python3-pip
python3-virtualenv
cryptsetup-nuke-password
vboot-kernel-utils
vboot-utils
