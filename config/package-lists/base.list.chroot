# ArgOS base system: shell, terminal, networking, boot. The desktop
# environment itself (Xfce + lightdm + Calamares) is a separate, explicit
# departure from ArgOS's original CLI-only design -- see
# config/package-lists/desktop.list.chroot.

kali-archive-keyring

# Kali's own official CLI-only base metapackages -- pull in whatever base
# CLI tooling Kali itself considers core, so ArgOS stays in sync with
# upstream's own definition of "the base" rather than drifting from a
# hand-picked list.
kali-linux-core
kali-system-cli

# Kernel / boot / live infrastructure
linux-image-amd64
firmware-linux
firmware-iwlwifi
firmware-realtek
live-boot
live-config
live-config-systemd
grub-pc
grub-efi-amd64-bin
grub-efi-ia32-bin
grub-common
mtools
plymouth
plymouth-themes
zstd
os-prober
parted
gdisk
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
cryptsetup
lvm2

# squashfs-tools and efibootmgr -- not needed for the live session
# itself, but both are real, confirmed dependencies of the "Install
# ArgOS" path that --apt-recommends false silently dropped, the same
# way it dropped xserver-xorg and desktop-base before these. Found by
# systematically resolving every installed package's Recommends
# against the real Kali index rather than waiting for the next thing
# to break:
#   - squashfs-tools: calamares itself Recommends this, and its own
#     shipped unpackfs.conf (confirmed by reading it directly) unpacks
#     a `sourcefs: "squashfs"` image -- without the tool to actually
#     extract one, clicking "Install ArgOS" would very likely fail
#     partway through, not at boot/live-session time where it'd never
#     get noticed.
#   - efibootmgr: grub-efi-amd64-bin Recommends this, and Calamares'
#     own bootloader.conf explicitly calls out `/usr/bin/efibootmgr`
#     as a tool its bootloader module may need. Without it, grub-
#     install's UEFI boot-entry registration on the target disk could
#     silently fail to register ArgOS as bootable, even if the files
#     themselves copied over fine.
squashfs-tools
efibootmgr

# live-tools -- live-persistence/live-toram/live-medium-eject and
# friends. Genuinely useful live-session utilities (not just
# completionism) for a live-USB-first distro; Recommended by
# live-boot/live-config but dropped by --apt-recommends false like
# everything above.
live-tools

# xauth -- Recommended by openssh-client/openssh-server/xclip/
# xserver-common; needed for X11 cookie-based auth (SSH -X forwarding,
# some clipboard operations via xclip).
xauth

# Shell / terminal environment
bash
bash-completion
zsh
tmux
screen
vim
nano
less
man-db
locales
console-setup
keyboard-configuration
sudo
dialog
whiptail

# Core CLI utilities
coreutils
findutils
grep
sed
gawk
curl
wget
git
rsync
htop
btop
tree
unzip
zip
7zip
jq
ripgrep
axel
rake
expect
dos2unix

# Networking stack (CLI only)
iproute2
net-tools
isc-dhcp-client
network-manager
wpasupplicant
wireless-tools
iw
usbutils
pciutils
openssh-client
openssh-server
bind9-dnsutils
traceroute
netcat-traditional
socat
proxychains4
tcpdump
nftables
ethtool
ifenslave
vlan
openvpn
vpnc
miredo
cifs-utils
telnet
unrar
plocate

# System services
systemd-timesyncd
apt-transport-https
ca-certificates
gnupg
pipx
python3-pip
python3-virtualenv
cryptsetup-nuke-password
vboot-kernel-utils
vboot-utils

# apparmor -- Kali's own kernel package (linux-image-amd64)
# Recommends this directly: the kernel itself expects this security
# framework to be present, dropped like everything else by
# --apt-recommends false. A security-focused distro going without the
# MAC framework its own kernel assumes is there isn't a tradeoff worth
# making silently.
apparmor

# dnsmasq-base -- Recommended by network-manager; without it,
# NetworkManager's own hotspot/shared-connection mode (acting as a
# Wi-Fi AP, genuinely relevant on a wireless-pentesting distro) doesn't
# have the DHCP/DNS component it needs.
dnsmasq-base

# easy-rsa -- Recommended by openvpn; a small, self-contained CA
# toolkit for generating OpenVPN certs/keys, useful on its own.
easy-rsa
