# ArgOS desktop environment + graphical installer.
#
# This is a deliberate departure from ArgOS's original CLI-only design:
# a real Xfce desktop (Kali's own default DE) with a login manager and a
# graphical installer, matching the "proper, like Kali/Ubuntu/Fedora/
# Debian" experience rather than a console-only live system.

# The actual X server. This is the real fix for the "boots straight to
# a tty1 shell, never reaches a graphical session" bug -- the earlier
# `systemctl set-default graphical.target` fix was necessary but not
# sufficient. Both `xfce4` and `lightdm` only *Recommend* xserver-xorg,
# they don't Depend on it (confirmed against the real Kali package
# index), so with --apt-recommends false set globally in auto/config,
# no X server at all was ever being installed: lightdm.service starts,
# has nothing to launch, fails, and the console just stays on
# live-config's own tty1 autologin shell -- which looks identical to
# "never left the CLI" even though graphical.target was in fact active.
# xserver-xorg's own Depends (not Recommends) pull in
# xserver-xorg-video-all, which includes the vesa/fbdev drivers a
# default VirtualBox VGA adapter needs.
xserver-xorg

# Kali's own official Xfce desktop metapackage -- pulls the full stack
# (Xfce itself, lightdm + greeter, qterminal, thunar, Kali's own
# branding/menu/theme packages, Firefox, etc.) the same way
# kali-linux-headless gave us a verified, Kali-maintained base for the
# CLI tools instead of hand-picking every package ourselves.
kali-desktop-xfce

# Live-session specific conveniences (zerofree, onboard on-screen
# keyboard, etc.) that Kali's own live image also includes.
kali-desktop-live

# --apt-recommends false (set globally in auto/config) means these two
# don't come along for free with kali-desktop-xfce, but they're what
# actually makes Thunar able to auto-mount/browse USB drives -- which
# matters a lot on a live/forensics-adjacent distro.
gvfs-backends
gvfs-fuse

# Graphical installer (Calamares) -- partitioning, disk encryption
# options, locale/timezone, and real user creation, same tool Kali's own
# live image ships with.
calamares
calamares-settings-debian

# Always-on system metrics panel widgets (CPU/RAM/network/temperature).
# These are also in kali-desktop-xfce's own Recommends, but
# --apt-recommends false drops them, so listed explicitly. lm-sensors is
# what xfce4-sensors-plugin actually reads temperature data from.
xfce4-cpugraph-plugin
xfce4-systemload-plugin
xfce4-netload-plugin
xfce4-sensors-plugin
lm-sensors

# Default browser and terminal (see
# config/hooks/normal/0170-set-default-apps.hook.chroot for actually
# making them the defaults, not just installed).
chromium
terminator

# notify-send (the update checker's login-time notifier uses this).
# xfce4-notifyd itself depends on libnotify4, the runtime *library* --
# that's not the same package as this, the CLI binary, so it needs
# listing explicitly rather than assuming it rides along.
libnotify-bin

# zenity -- the actual input/output dialogs behind the one-click panel
# tool-finder (argos-toolfinder-gui).
zenity

# xrandr + gtf (confirmed real -- gtf itself ships directly inside
# xserver-xorg-core, already a hard dependency via xserver-xorg, but
# the xrandr CLI binary is its own package and xfce4-settings only
# depends on libxrandr2, the library, not this). Used by
# argos-set-resolution to default the session to 1920x1080.
x11-xserver-utils
