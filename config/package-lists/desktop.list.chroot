# ArgOS desktop environment + graphical installer.
#
# This is a deliberate departure from ArgOS's original CLI-only design:
# a real Xfce desktop (Kali's own default DE) with a login manager and a
# graphical installer, matching the "proper, like Kali/Ubuntu/Fedora/
# Debian" experience rather than a console-only live system.

# The actual X server. This is the real fix for the "boots straight to
# a tty1 shell, never reaches a graphical session" bug -- the earlier
# `systemctl set-default graphical.target` fix was necessary but not
# sufficient. Both `xfce4` and `lightdm` only *Recommend* xserver-xorg,
# they don't Depend on it (confirmed against the real Kali package
# index), so with --apt-recommends false set globally in auto/config,
# no X server at all was ever being installed: lightdm.service starts,
# has nothing to launch, fails, and the console just stays on
# live-config's own tty1 autologin shell -- which looks identical to
# "never left the CLI" even though graphical.target was in fact active.
# xserver-xorg's own Depends (not Recommends) pull in
# xserver-xorg-video-all, which includes the vesa/fbdev drivers a
# default VirtualBox VGA adapter needs.
xserver-xorg

# Kali's own official Xfce desktop metapackage -- pulls the full stack
# (Xfce itself, lightdm + greeter, qterminal, thunar, Kali's own
# branding/menu/theme packages, Firefox, etc.) the same way
# kali-linux-headless gave us a verified, Kali-maintained base for the
# CLI tools instead of hand-picking every package ourselves.
kali-desktop-xfce

# Live-session specific conveniences (zerofree, onboard on-screen
# keyboard, etc.) that Kali's own live image also includes.
kali-desktop-live

# --apt-recommends false (set globally in auto/config) means these two
# don't come along for free with kali-desktop-xfce, but they're what
# actually makes Thunar able to auto-mount/browse USB drives -- which
# matters a lot on a live/forensics-adjacent distro.
gvfs-backends
gvfs-fuse

# Graphical installer (Calamares) -- partitioning, disk encryption
# options, locale/timezone, and real user creation, same tool Kali's own
# live image ships with.
calamares
calamares-settings-debian

# Always-on system metrics panel widgets (CPU/RAM/network). These are
# also in kali-desktop-xfce's own Recommends, but --apt-recommends
# false drops them, so listed explicitly.
xfce4-cpugraph-plugin
xfce4-systemload-plugin
xfce4-netload-plugin

# xfce4-sensors-plugin + lm-sensors (temperature) -- still installed,
# just not on the default panel (argos-setup-panel-widgets): it
# rendered nothing visible in every sandbox test, idle or under real
# synthetic load (no real hwmon/ACPI thermal sensors in a container --
# may well work fine on real hardware or a real VM, that's just not
# something this sandbox can verify either way). Addable later via
# Panel Preferences if it does.
xfce4-sensors-plugin
lm-sensors

# Default browser and terminal (see
# config/hooks/normal/0170-set-default-apps.hook.chroot for actually
# making them the defaults, not just installed).
chromium
terminator

# notify-send (the update checker's login-time notifier uses this).
# xfce4-notifyd itself depends on libnotify4, the runtime *library* --
# that's not the same package as this, the CLI binary, so it needs
# listing explicitly rather than assuming it rides along.
libnotify-bin

# zenity -- the actual input/output dialogs behind the one-click panel
# tool-finder (argos-toolfinder-gui).
zenity

# xrandr + gtf (confirmed real -- gtf itself ships directly inside
# xserver-xorg-core, already a hard dependency via xserver-xorg, but
# the xrandr CLI binary is its own package and xfce4-settings only
# depends on libxrandr2, the library, not this). Used by
# argos-set-resolution to default the session to 1920x1080.
x11-xserver-utils

# sassc -- the only real build dependency for ArgOS's own GTK3+xfwm4
# theme (built at image-build time from an upstream project; see
# 0185-install-argos-gtk-theme.hook.chroot). Confirmed by reading that
# project's install.sh directly: it's a pure CSS/SCSS theme, no legacy
# murrine rendering engine involved despite the project's README
# listing it as a requirement.
sassc

# desktop-base -- this is the real fix for the "desktop is just a
# plain black canvas" bug the argos-set-wallpaper race-condition fix
# didn't fully solve. Confirmed directly from a real boot: xfdesktop
# has ZERO xfconf backdrop/last-image properties on a fresh session
# because it CRASHES on startup, and the crash message
# ("Failed to load image file '(null)': Error opening file
# /usr/share/images/desktop-base/default: No such file or directory")
# points straight at this -- xfdesktop needs *some* fallback image to
# bootstrap from before it creates its own real backdrop properties,
# and that fallback path is shipped by desktop-base specifically, which
# nothing in our package set pulls in (confirmed: neither xfdesktop4
# nor kali-desktop-xfce Depends or even Recommends it -- another
# --apt-recommends false casualty, the same bug class as the missing
# xserver-xorg). Without it, xfdesktop never successfully initializes,
# so argos-set-wallpaper's wait-for-last-image loop never finds
# anything to overwrite -- not a bug in that script, a missing
# dependency it was never able to work around.
desktop-base

# fonts-nerd-symbols -- without this, Powerlevel10k's "rainbow" preset
# renders as missing-glyph boxes instead of its signature look. That
# preset sets POWERLEVEL9K_MODE=nerdfont-complete (confirmed by reading
# the actual preset file, not assumed), which needs ~3000 Private-Use-
# Area glyphs (segment separators, folder/git/lock icons) that plain
# Fira Code doesn't contain (confirmed directly: the real shipped
# fonts-firacode .ttf has only 23 PUA codepoints total, not the full
# icon set). This package is a fontconfig-level fallback specifically
# for this -- confirmed its shipped config already aliases "Fira Code"/
# "Fira Code Medium" (our configured MonospaceFontName) to fall back to
# it automatically, with the activating symlink already present in the
# package itself, not something this hook needs to wire up.
fonts-nerd-symbols

# thunar-volman -- found the same way as desktop-base: Recommended by
# BOTH thunar and xfce4 (two independent sources agreeing it matters),
# dropped by --apt-recommends false. This is what actually handles
# auto-mount/autoplay policy when removable media is inserted --
# gvfs-backends/gvfs-fuse above make mounting *possible*, this is what
# makes it happen automatically without the user digging through a
# file manager menu. Directly relevant on a forensics-adjacent distro
# that deals with USB media constantly.
thunar-volman

# tumbler -- thumbnail generation for Thunar/xfdesktop/Ristretto.
# Recommended by thunar, xfdesktop4, AND ristretto. Not just cosmetic:
# the real crash log from the xfdesktop bug this project just fixed
# (0176-fix-xfdesktop-fallback-image.hook.chroot) shows
# "Thumbnailer failed calling GetFlavors" as a warning right before the
# fatal part -- this was already visibly missing, just not the
# headline symptom.
tumbler

# The macOS-style look (0185/0186) is two pieces: a GTK3+xfwm4 theme
# and an icon theme. The rest of this block is the third piece --
# the actual panel/dock layout to put them on, configured at first
# login by argos-setup-panel-widgets (xfconf-query directly, not
# hand-authored XML -- same reasoning as that script's own header
# comment: the panel/plugin-ID schema is fragile and version-
# dependent, so this uses the panel's own real provisioning path).
#
# No dock package needed here: the bottom dock (argos-setup-panel-
# widgets) is ten `launcher` plugins, one real .desktop file each
# (thunar, qterminal, firefox-esr, and others), all of which are
# already real Depends of kali-desktop-xfce/kali-desktop-core below --
# nothing extra to install. (Plank and cairo-dock were tried first and
# dropped: confirmed directly against the real kali-rolling archive,
# neither actually exists there. xfce4-docklike-plugin was tried after
# that and also dropped -- it was never once confirmed to render
# anything in this project's own sandbox, a dependency mismatch meant
# its .so was never even present to test, so every prior dock
# screenshot from this sandbox showed an empty panel. A fixed row of
# launchers is something this project can actually verify end to end.)

# xfce4-pulseaudio-plugin, xfce4-power-manager-plugins,
# xfce4-indicator-plugin -- the macOS-style top-bar status-icon
# cluster (volume/battery/notification-area icons next to the
# clock). None of these are pulled in by kali-desktop-xfce's default
# panel layout, which uses a plain systray instead.
xfce4-pulseaudio-plugin
xfce4-power-manager-plugins
xfce4-indicator-plugin

# network-manager-applet -- nm-applet, so the network-manager
# package already in base.list.chroot actually has a status icon to
# show in the indicator plugin above. Without this, NetworkManager
# still works, it's just invisible from the panel. (network-manager-
# gnome was tried first and doesn't exist in kali-rolling under that
# name -- confirmed against the real archive -- this is the real
# package name there.)
network-manager-applet
