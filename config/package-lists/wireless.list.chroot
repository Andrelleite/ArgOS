# Wireless attacks -- CLI only.
# Explicitly excluded: zenmap (GUI nmap front-end, listed here since it's
# wireless/recon-adjacent in some package sets -- not installed anywhere).

aircrack-ng
reaver
bully
wifite
mdk4
pixiewps
cowpatty
kismet
macchanger

# From Kali's own kali-linux-headless metapackage.
bluez
i2c-tools
minicom
multimac
rfkill
sakis3g
spooftooph
voiphopper

# wireless-regdb -- Recommended by both iw and network-manager, dropped
# by --apt-recommends false like everything else in this category.
# The regulatory-domain database affects which channels/power levels
# the kernel's wireless stack considers legal; without it, some iw/
# NetworkManager wireless operations can behave inconsistently
# depending on what (if anything) the driver defaults to.
wireless-regdb
